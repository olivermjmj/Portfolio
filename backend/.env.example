# Fill these only on the server. Never commit .env or put keys in hugo.yaml.
OPENAI_API_KEY=replace-openai-project-key
DIFY_API_KEY=replace-dify-knowledge-api-key
DIFY_DATASET_ID=replace-dataset-uuid
DIFY_BASE_URL=https://api.dify.ai/v1
PORTFOLIO_BASE_URL=https://olivermjmj.github.io/Portfolio/
ALLOWED_ORIGINS=https://olivermjmj.github.io
# Exact IP of your reverse proxy as seen by the container (not an entire subnet).
# Until configured, forwarded headers are ignored and visitors share the proxy's rate limit.
TRUSTED_PROXY_IPS=
